{
  "name": "afterframe-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.8.2 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:migration:008:predeploy": "AFTERFRAME_DB_MIGRATION_PREFLIGHT=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-04a-migration-predeploy.integration.test.ts",
    "test:migration:009:predeploy": "AFTERFRAME_DB_MIGRATION_009_PREFLIGHT=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-04b-migration-predeploy.integration.test.ts",
    "test:migration:010:predeploy": "AFTERFRAME_DB_MIGRATION_010_PREFLIGHT=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-04b-takeover-reader-predeploy.integration.test.ts",
    "test:migration:011:predeploy": "AFTERFRAME_DB_MIGRATION_011_PREFLIGHT=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-04b-terminal-acceptance-predeploy.integration.test.ts",
    "test:migration:012:predeploy": "AFTERFRAME_DB_INTEGRATION=1 AFTERFRAME_DB_MIGRATION_012_PREFLIGHT=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-03-postgres.integration.test.ts",
    "test:migration:013:predeploy": "AFTERFRAME_DB_INTEGRATION=1 AFTERFRAME_DB_MIGRATION_013_PREFLIGHT=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-04c-resolution-migration-predeploy.integration.test.ts src/infrastructure/persistence/__tests__/checkpoint-03-postgres.integration.test.ts",
    "test:migration:014:predeploy": "AFTERFRAME_DB_INTEGRATION=1 AFTERFRAME_DB_MIGRATION_014_PREFLIGHT=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-04d-retrieval-migration-predeploy.integration.test.ts src/infrastructure/persistence/__tests__/checkpoint-03-postgres.integration.test.ts",
    "db:migrate:014": "node scripts/deploy-migration-014.mjs",
    "test:integration:resolution": "AFTERFRAME_DB_INTEGRATION=1 AFTERFRAME_DB_RESOLUTION_INTEGRATION=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-03-postgres.integration.test.ts",
    "test:integration:retrieval": "AFTERFRAME_DB_INTEGRATION=1 AFTERFRAME_DB_RETRIEVAL_INTEGRATION=1 vitest run src/infrastructure/persistence/__tests__/checkpoint-03-postgres.integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "next": "16.3.0",
    "openai": "7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
