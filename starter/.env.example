# The public starter remains deterministic. Live research is activated only by
# a server-side durable worker; never expose this key to browser code.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
OPENAI_MODEL=gpt-5.6
OPENAI_ORCHESTRATOR_MODEL=gpt-5.6
OPENAI_VERIFIER_MODEL=gpt-5.6
OPENAI_CLOSURE_MODEL=gpt-5.6
OPENAI_WORKER_MODEL=gpt-5.6-terra

# Authenticated production persistence (server RPCs use the service role only
# after Supabase Auth has verified the caller). Copy all four values from the
# same project; never combine an API URL/key set with another project's pooler.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server migration/worker administration only. Copy the complete Session
# Pooler URI (port 5432) from Connect on environments without IPv6; URL-encode
# special characters in passwords. No separate pooler parameters are required.
SUPABASE_DB_URL=

# Server-only movie identity resolver. TMDB metadata identifies a movie; it is
# never promoted to research evidence.
TMDB_API_KEY=

# `fixture` performs no paid/network research. `shadow` enables the bounded
# source-candidate adapter for a future durable worker; it still cannot publish
# candidates as evidence.
AFTERFRAME_RESEARCH_MODE=fixture

# Live background discovery remains fail-closed unless the OpenAI organization
# has actually been approved for Modified Abuse Monitoring. Do not copy these
# placeholders into `.env.local` or assert this mode based only on `store=false`.
# AFTERFRAME_OPENAI_BACKGROUND_DATA_CONTROL_MODE=MODIFIED_ABUSE_MONITORING
# AFTERFRAME_OPENAI_PROJECT_ID=
# AFTERFRAME_OPENAI_DATA_CONTROL_ATTESTED_AT=
# AFTERFRAME_OPENAI_DATA_CONTROL_ATTESTED_BY=

# Keep mock mode on until the durable research pipeline and authenticated
# adapters pass provenance, resolver, security, cost, and domain eval gates.
AFTERFRAME_MOCK_MODE=true

# Observability and budgets. Keep private content out of traces.
AFTERFRAME_TRACE_SAMPLE_RATE=1
AFTERFRAME_MAX_CASE_COST_USD=5
AFTERFRAME_MAX_BRANCH_COST_USD=1
AFTERFRAME_MAX_CONCURRENT_JOBS=4

# Cross-case memory remains opt-in.
AFTERFRAME_CROSS_CASE_MEMORY_DEFAULT=false
