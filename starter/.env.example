# The starter works without this key by returning deterministic mock output.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_ORCHESTRATOR_MODEL=gpt-5.6
OPENAI_VERIFIER_MODEL=gpt-5.6
OPENAI_CLOSURE_MODEL=gpt-5.6
OPENAI_WORKER_MODEL=gpt-5.6-terra

# Optional persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional film identity/metadata provider. Not wired into the starter yet.
TMDB_API_KEY=

# Explicitly keep mock mode on until the visual vertical slice is approved.
AFTERFRAME_MOCK_MODE=true

# Observability and budgets. Keep private content out of traces.
AFTERFRAME_TRACE_SAMPLE_RATE=1
AFTERFRAME_MAX_CASE_COST_USD=5
AFTERFRAME_MAX_BRANCH_COST_USD=1
AFTERFRAME_MAX_CONCURRENT_JOBS=4

# Cross-case memory remains opt-in.
AFTERFRAME_CROSS_CASE_MEMORY_DEFAULT=false
